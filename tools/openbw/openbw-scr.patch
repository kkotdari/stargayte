+		   어긋난다** — 그래서 초반에는 맞다가 유닛이 늘수록 명령이 헛돌았다. */
+		size_t idx = (size_t)(raw & 0x1fff);
+		if (!idx) return nullptr;
+		unit_t* u = get_unit(idx - 1);
+		bool ok = false;
+		/* 세대 셈 후보(BWDUMP_GENRULE): 0=그대로 1=아무거나 2=만들때+죽을때 둘 다 셈
