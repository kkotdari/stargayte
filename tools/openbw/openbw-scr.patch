+	/* 리마스터(1.21+)의 유닛 태그를 우리 유닛으로 옮긴다.
+	 *
+	 *  옛 태그는 `(index+1) | (generation << 11)`인 16비트였다. 리마스터는 32비트로 넓히면서
+	 *  **칸의 폭과 시작점을 함께 바꿨다**: index 칸이 13비트가 되고, 그 값이 1700(유닛 배열
+	 *  크기)만큼 밀려 있다. 곧
+	 *      태그 = (index + 1 + 1700) | (generation << 13)
+	 *  이다. 이 자리를 옛 규약으로 읽으면 index가 엉뚱한 곳(1700 남짓 위)을 가리켜, 고르기가
+	 *  **늘 빈손**이 되고 그러면 명령이 다 실행되는데도 아무 일이 안 일어난다.
+	 *
+	 *  어떻게 알아냈나 — 같은 지도(UGL 17 Anti-Hack)의 1.16 판과 리마스터 판을 나란히 돌렸다.
+	 *  1.16의 태그는 우리 id와 **한 자리도 안 틀리고** 같았고(3255·3256·3269…), 리마스터의
+	 *  태그는 임자가 누구든 정확히 **7844**만큼 컸다. 7844 = 1700 + 4×2048 − 2048×1 이므로
+	 *  위 식으로 떨어지고, 다른 지도(New Super빠른무한)에서도 그대로 맞았다. */
+	unit_t* get_unit_scr(uint32_t raw) const {
+		size_t idx = (size_t)(raw & 0x1fff);
+		bool ok = false, slot = false;
+		unit_t* r9 = nullptr;
+		if (idx > 1700) {
+			idx -= 1700;
+			unit_t* u = get_unit(idx - 1);
+			slot = !!u;
+			if (u && u->unit_id_generation % (1u << 19) == (raw >> 13)) { r9 = u; ok = true; }
+		}
+		if (getenv("BWDUMP_RESOLVE")) {
+			bwdump_resolve((int)st.current_frame, ok, slot);
+		}
+		return r9;
+	}
+
+	/* ── 리마스터(1.21+)의 명령 여섯 ── 0x60~0x65는 옛 0x14·0x15·0x18·0x09·0x0a·0x0b와
+	   하는 일이 같고, **유닛 태그가 16비트가 아니라 32비트**인 것만 다르다.
+	   (screp은 그 뒤 절반을 "Unknown, always 0?"로 건너뛰지만, 실제로는 세대(generation)가
+	   그 위쪽 비트에 실리는 확장 태그다 — OpenBW의 unit_id_32가 바로 그 꼴이고, 아래
+	   변환도 그것을 쓴다. 16비트만 읽고 나머지를 버리면 세대가 안 맞아 get_unit이 늘
+	   nullptr을 돌려주고, 그러면 **명령은 실행되는데 아무 일도 안 일어난다**.)
+	   1.21부터는 이 여섯만 쓰이므로, 없으면 요즘 리플레이는 첫 명령에서 죽는다. */
+	template<typename reader_T>
+	bool read_action_default_order_121(int owner, reader_T&& r) {
+		int x = r.template get<int16_t>();
+		int y = r.template get<int16_t>();
+		unit_t* target = get_unit_scr(r.template get<uint32_t>());
+		UnitTypes target_unit_type_id = (UnitTypes)r.template get<uint16_t>();
+		const unit_type_t* target_unit_type = target_unit_type_id == UnitTypes::None ? nullptr : get_unit_type(target_unit_type_id);
+		bool queue = r.template get<uint8_t>() != 0;
+		return action_default_order(owner, {x, y}, target, target_unit_type, queue);
+	}
+	template<typename reader_T>
+	bool read_action_order_121(int owner, reader_T&& r) {
+		int x = r.template get<int16_t>();
+		int y = r.template get<int16_t>();
+		unit_t* target = get_unit_scr(r.template get<uint32_t>());
+		UnitTypes target_unit_type_id = (UnitTypes)r.template get<uint16_t>();
+		const unit_type_t* target_unit_type = target_unit_type_id == UnitTypes::None ? nullptr : get_unit_type(target_unit_type_id);
+		Orders order_id = (Orders)r.template get<uint8_t>();
+		const order_type_t* order_type = get_order_type(order_id);
+		bool queue = r.template get<uint8_t>() != 0;
+		return action_order(owner, order_type, {x, y}, target, target_unit_type, queue);
+	}
+	template<typename reader_T>
+	bool read_action_unload_121(int owner, reader_T&& r) {
+		unit_t* target = get_unit_scr(r.template get<uint32_t>());
+		return action_unload(owner, target);
+	}
+
+	/* ── 리마스터(1.21+)의 고르기 셋 ── 0x63·0x64·0x65는 0x09·0x0a·0x0b와 하는 일이
+	   같지만 **유닛 하나에 4바이트**를 쓴다: 태그(uint16) 뒤에 늘 0인 uint16이 붙는다
+	   (icza/screp의 repparser가 그 자리를 "Unknown, always 0?"로 건너뛴다).
+	   1.21부터 이 셋만 쓰이므로, 이것이 없으면 요즘 리플레이는 첫 고르기에서 죽는다. */
+	template<typename reader_T>
+	static_vector<unit_t*, 12> read_selection_121(reader_T&& r) {
+		size_t n = r.template get<uint8_t>();
+		if (n > 12) error("invalid selection of %d units", n);
+		static_vector<unit_t*, 12> units;
+		for (size_t i = 0; i != n; ++i) {
+			units.push_back(get_unit_scr(r.template get<uint32_t>()));
+		}
+		return units;
+	}
+	template<typename reader_T>
+	bool read_action_select_121(int owner, reader_T&& r) {
+		return action_select(owner, read_selection_121(std::forward<reader_T>(r)));
+	}
+	template<typename reader_T>
+	bool read_action_shift_select_121(int owner, reader_T&& r) {
+		return action_shift_select(owner, read_selection_121(std::forward<reader_T>(r)));
+	}
+	template<typename reader_T>
+	bool read_action_deselect_121(int owner, reader_T&& r) {
+		return action_deselect(owner, read_selection_121(std::forward<reader_T>(r)));
+	}
+
 	template<typename reader_T>
 	bool read_action_shift_select(int owner, reader_T&& r) {
 		size_t n = r.template get<uint8_t>();
@@ -1349,6 +1442,19 @@ struct action_functions: state_functions {
